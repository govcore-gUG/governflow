        "@types/react-dom": "~19.2.7",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.2.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
