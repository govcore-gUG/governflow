# Example configuration. Copy to .env and fill in local values.
# This repository is public: only placeholders here, never real hosts or secrets.

APP_NAME=GovernFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 (matches the CI service; the password is provided by the environment)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app_test
DB_USERNAME=app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Sanctum: hosts whose SPA requests are authenticated via the session cookie
SANCTUM_STATEFUL_DOMAINS=localhost

# Authentik (OIDC via Socialite, backend-for-frontend). Placeholders only.
AUTHENTIK_BASE_URL=https://auth.example.invalid
AUTHENTIK_CLIENT_ID=change-me
AUTHENTIK_CLIENT_SECRET=change-me
AUTHENTIK_REDIRECT_URI="${APP_URL}/auth/callback"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"
